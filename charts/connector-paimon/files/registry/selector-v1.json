{
  "type": "object",
  "properties": {
    "database": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "table": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "snapshotId": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$"
    },
    "tag": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    }
  },
  "required": [
    "database"
  ],
  "additionalProperties": false,
  "not": {
    "required": [
      "snapshotId",
      "tag"
    ]
  }
}
