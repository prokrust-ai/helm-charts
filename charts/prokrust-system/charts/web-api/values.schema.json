{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "global",
    "images",
    "webApi"
  ],
  "properties": {
    "global": {
      "type": "object",
      "required": [
        "imagePullSecrets",
        "networkPolicy"
      ],
      "properties": {
        "placementTemplates": { "type": "object" },
        "workloadPlacementProfile": {
          "type": "string",
          "default": "arm64",
          "enum": [
            "standard",
            "arm64"
          ]
        },
        "imagePullSecrets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/name"
              }
            }
          }
        },
        "networkPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dns",
            "apiServerEndpoints",
            "artifactStore",
            "ballista",
            "inferenceClientPodSelector"
          ],
          "properties": {
            "dns": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "namespaceSelector",
                "podSelector"
              ],
              "properties": {
                "namespaceSelector": {
                  "$ref": "#/$defs/labels"
                },
                "podSelector": {
                  "$ref": "#/$defs/labels"
                }
              }
            },
            "apiServerEndpoints": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "cidr",
                  "port"
                ],
                "properties": {
                  "cidr": {
                    "$ref": "#/$defs/ipCidr"
                  },
                  "port": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  }
                }
              }
            },
            "artifactStore": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cidrs",
                "podSelector",
                "port"
              ],
              "properties": {
                "cidrs": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/ipCidr"
                  }
                },
                "podSelector": {
                  "$ref": "#/$defs/labels"
                },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              }
            },
            "sourceStore": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cidrs",
                "podSelector",
                "port"
              ],
              "properties": {
                "cidrs": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/ipCidr"
                  }
                },
                "podSelector": {
                  "$ref": "#/$defs/labels"
                },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              }
            },
            "ballista": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "podSelector",
                "ports"
              ],
              "properties": {
                "podSelector": {
                  "$ref": "#/$defs/labels"
                },
                "ports": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  }
                }
              }
            },
            "inferenceClientPodSelector": {
              "$ref": "#/$defs/labels"
            },
            "gcpAuth": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "enabled",
                "metadataEndpoints",
                "googleApiCIDRs"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "metadataEndpoints": {
                  "type": "array",
                  "maxItems": 2,
                  "uniqueItems": true,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "cidr",
                      "ports"
                    ],
                    "properties": {
                      "cidr": {
                        "enum": [
                          "169.254.169.252/32",
                          "169.254.169.254/32"
                        ]
                      },
                      "ports": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 4,
                        "uniqueItems": true,
                        "items": {
                          "enum": [
                            80,
                            8080,
                            987,
                            988
                          ]
                        }
                      }
                    }
                  }
                },
                "googleApiCIDRs": {
                  "type": "array",
                  "maxItems": 128,
                  "uniqueItems": true,
                  "items": {
                    "allOf": [
                      {
                        "$ref": "#/$defs/ipCidr"
                      },
                      {
                        "not": {
                          "pattern": "/0$"
                        }
                      }
                    ]
                  }
                }
              }
            },
            "awsAuth": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "enabled",
                "stsCIDRs",
                "podIdentityAgentEnabled"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "stsCIDRs": {
                  "type": "array",
                  "maxItems": 8,
                  "uniqueItems": true,
                  "items": {
                    "allOf": [
                      {
                        "$ref": "#/$defs/ipCidr"
                      },
                      {
                        "pattern": "/(32|128)$"
                      }
                    ],
                    "not": {
                      "anyOf": [
                        {
                          "pattern": "(?i)^(0\\.|127\\.|169\\.254\\.|fd00:0?ec2:|fe[89ab][0-9a-f]:|ff[0-9a-f]{2}:|(22[4-9]|2[3-4][0-9]|25[0-5])\\.|((0{1,4}:){7}0{0,3}[01]|(0{1,4}(:0{1,4})*)?::(0{1,4}:)*0{0,3}[01]?)/)"
                        },
                        {
                          "pattern": "(?i)^((0{1,4}(:0{1,4})*)?::(0{1,4}:)*ffff:|(0{1,4}:){5}ffff:)"
                        }
                      ]
                    }
                  }
                },
                "podIdentityAgentEnabled": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        "networkFamily": {
          "type": "string",
          "enum": [
            "IPv4",
            "IPv6"
          ],
          "default": "IPv4"
        },
        "awsRegion": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^$|^[a-z]{2}(-[a-z]+)+-[0-9]+$"
        }
      }
    },
    "images": {
      "type": "object",
      "required": [
        "webApi"
      ],
      "additionalProperties": false,
      "properties": {
        "webApi": {
          "$ref": "#/$defs/image"
        }
      }
    },
    "webApi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "replicas"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "artifactFederation": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "configMapName",
            "configKey",
            "audience"
          ],
          "properties": {
            "configMapName": {
              "$ref": "#/$defs/name"
            },
            "configKey": {
              "$ref": "#/$defs/secretKey"
            },
            "audience": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "artifactWorkloadIdentity": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "provider",
            "roleArn"
          ],
          "properties": {
            "provider": {
              "type": "string",
              "enum": [
                "IRSA",
                "EKSPodIdentity"
              ]
            },
            "roleArn": {
              "type": "string",
              "maxLength": 2048,
              "pattern": "^arn:(aws|aws-us-gov|aws-cn):iam::[0-9]{12}:role/[A-Za-z0-9+=,.@_/-]+$"
            }
          }
        },
        "browserOrigin": {
          "type": "string",
          "pattern": "^$|^https://[A-Za-z0-9][A-Za-z0-9.:-]*$"
        },
        "argoUiBaseUrl": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^$|^https?://[A-Za-z0-9][A-Za-z0-9.:-]*(/[A-Za-z0-9._~!$&()*+,;=:@%/-]*)?$"
        },
        "renderFromParent": {
          "type": "boolean"
        },
        "connectorRegistryConfigMap": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "connectorRegistryItems": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "path"
            ],
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 253,
                "pattern": "^[-._a-zA-Z0-9]+$"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^[a-zA-Z0-9_-][a-zA-Z0-9._-]*(/[a-zA-Z0-9_-][a-zA-Z0-9._-]*)*$"
              }
            }
          }
        }
      }
    },
    "awsAuth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stsNetworkCIDRs"
      ],
      "properties": {
        "stsNetworkCIDRs": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "description": "Explicit STS destination networks: IPv4 /23 through /32 or IPv6 /56 through /128. Verify published regional ranges before configuring. The union with global exact hosts is capped at eight destinations.",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/ipCidr"
              },
              {
                "pattern": "^([0-9.]+/(2[3-9]|3[0-2])|[0-9A-Fa-f:]+/(5[6-9]|[6-9][0-9]|1[01][0-9]|12[0-8]))$"
              }
            ],
            "not": {
              "anyOf": [
                {
                  "pattern": "(?i)^(0\\.|127\\.|169\\.254\\.|fd00:0?ec2:|fe[89ab][0-9a-f]:|ff[0-9a-f]{2}:|(22[4-9]|2[3-4][0-9]|25[0-5])\\.|((0{1,4}:){7}0{0,3}[01]|(0{1,4}(:0{1,4})*)?::(0{1,4}:)*0{0,3}[01]?)/)"
                },
                {
                  "pattern": "(?i)^((0{1,4}(:0{1,4})*)?::(0{1,4}:)*ffff:|(0{1,4}:){5}ffff:)"
                }
              ]
            }
          }
        }
      }
    }
  },
  "$defs": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "digest",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^@\\s]+$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
    },
    "secretKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "ipCidr": {
      "type": "string",
