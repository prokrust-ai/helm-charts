                },
                "podSelector": {
                  "$ref": "#/$defs/labels"
                }
              }
            },
            "apiServerEndpoints": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "cidr",
                  "port"
                ],
                "properties": {
                  "cidr": {
                    "$ref": "#/$defs/ipCidr"
                  },
                  "port": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  }
                }
              }
            },
            "artifactStore": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cidrs",
                "podSelector",
                "port"
              ],
              "properties": {
                "cidrs": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/ipCidr"
                  }
                },
                "podSelector": {
                  "$ref": "#/$defs/labels"
                },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              }
            },
            "sourceStore": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cidrs",
                "podSelector",
                "port"
              ],
              "properties": {
                "cidrs": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/ipCidr"
                  }
                },
                "podSelector": {
                  "$ref": "#/$defs/labels"
                },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              }
            },
            "ballista": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "podSelector",
                "ports"
              ],
              "properties": {
                "podSelector": {
                  "$ref": "#/$defs/labels"
                },
                "ports": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  }
                }
              }
            },
            "inferenceClientPodSelector": {
              "$ref": "#/$defs/labels"
            },
            "gcpAuth": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "enabled",
                "metadataEndpoints",
                "googleApiCIDRs"
              ],
              "properties": {
                "enabled": {
