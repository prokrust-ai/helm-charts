          "default": "arm64"
        },
        "imagePullSecrets": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 253,
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
              }
            }
          }
        },
        "networkPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dns",
            "apiServerEndpoints",
            "artifactStore",
            "ballista",
            "inferenceClientPodSelector"
          ],
          "properties": {
            "dns": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "namespaceSelector",
                "podSelector"
              ],
              "properties": {
