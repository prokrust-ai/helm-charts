{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "global",
    "images",
    "controllers",
    "artifactCredentials",
    "producerProvenance"
  ],
  "properties": {
    "licensing": {
      "type": "object",
      "properties": {
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "trustedSources",
            "serviceMonitor",
            "prometheusRule",
            "workloadSeries"
          ],
          "properties": {
            "trustedSources": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "namespaceSelector",
                  "podSelector"
                ],
                "properties": {
                  "namespaceSelector": {
                    "allOf": [
                      {
                        "$ref": "#/$defs/labels"
                      },
                      {
                        "minProperties": 1
                      }
                    ]
                  },
                  "podSelector": {
                    "allOf": [
                      {
                        "$ref": "#/$defs/labels"
                      },
                      {
                        "minProperties": 1
                      }
                    ]
                  }
                }
              }
            },
            "serviceMonitor": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "enabled",
                "labels"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "labels": {
                  "$ref": "#/$defs/labels"
                }
              }
            },
            "prometheusRule": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "enabled",
                "labels"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "labels": {
                  "$ref": "#/$defs/labels"
                }
              }
            },
            "workloadSeries": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "enabled",
                "maxOwners"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "maxOwners": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000
                }
              }
            }
          }
        },
        "startup": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tlsSecret"
          ],
          "properties": {
            "tlsSecret": {
              "$ref": "#/$defs/name"
            }
          }
        },
        "serverURL": {
          "type": "string",
          "pattern": "^https://"
        },
        "credentialSecret": {
          "$ref": "#/$defs/name"
        },
        "identitySecret": {
          "$ref": "#/$defs/name"
        },
        "entitlementSecret": {
          "$ref": "#/$defs/name"
        },
        "serverEgressCIDRs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ipCidr"
          }
        },
        "webhook": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowKonnectivityAgents": {
              "type": "boolean"
            },
            "certManager": {
              "type": "boolean"
            },
            "tlsSecret": {
              "$ref": "#/$defs/name"
            },
            "caBundle": {
              "type": "string"
            },
            "apiServerIngressCIDRs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ipCidr"
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "global": {
      "type": "object",
      "required": [
        "imagePullSecrets",
        "networkPolicy"
      ],
      "properties": {
        "dnsServerCIDRs": {
