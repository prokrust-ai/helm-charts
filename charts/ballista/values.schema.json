{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "global",
    "images"
  ],
  "properties": {
    "global": {
      "type": "object",
      "required": [
        "imagePullSecrets",
        "networkPolicy"
      ],
      "properties": {
        "imagePullSecrets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/name"
              }
            }
          }
        },
        "networkPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dns",
            "apiServerEndpoints",
            "artifactStore",
            "ballista",
            "inferenceClientPodSelector"
          ],
          "properties": {
            "dns": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "namespaceSelector",
                "podSelector"
              ],
              "properties": {
                "namespaceSelector": {
                  "$ref": "#/$defs/labels"
                },
                "podSelector": {
                  "$ref": "#/$defs/labels"
                }
              }
            },
            "apiServerEndpoints": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "cidr",
                  "port"
                ],
                "properties": {
                  "cidr": {
                    "$ref": "#/$defs/ipCidr"
                  },
                  "port": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  }
                }
              }
            },
            "artifactStore": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cidrs",
                "podSelector",
                "port"
              ],
              "properties": {
                "cidrs": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/ipCidr"
                  }
                },
                "podSelector": {
                  "$ref": "#/$defs/labels"
                },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              }
            },
            "sourceStore": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cidrs",
                "podSelector",
                "port"
              ],
              "properties": {
                "cidrs": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/ipCidr"
                  }
                },
                "podSelector": {
                  "$ref": "#/$defs/labels"
                },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              }
            },
            "ballista": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "podSelector",
                "ports"
              ],
              "properties": {
                "podSelector": {
                  "$ref": "#/$defs/labels"
                },
                "ports": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  }
                }
              }
            },
            "inferenceClientPodSelector": {
              "$ref": "#/$defs/labels"
            },
            "gcpAuth": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "enabled",
                "metadataEndpoints",
                "googleApiCIDRs"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "metadataEndpoints": {
                  "type": "array",
                  "maxItems": 2,
                  "uniqueItems": true,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "cidr",
                      "ports"
                    ],
                    "properties": {
                      "cidr": {
                        "enum": [
                          "169.254.169.252/32",
                          "169.254.169.254/32"
                        ]
                      },
                      "ports": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 4,
                        "uniqueItems": true,
                        "items": {
                          "enum": [
                            80,
                            8080,
                            987,
                            988
                          ]
                        }
                      }
                    }
                  }
                },
                "googleApiCIDRs": {
                  "type": "array",
                  "maxItems": 128,
                  "uniqueItems": true,
                  "items": {
                    "allOf": [
                      {
                        "$ref": "#/$defs/ipCidr"
                      },
                      {
                        "not": {
                          "pattern": "/0$"
                        }
                      }
                    ]
                  }
                }
              }
            },
            "awsAuth": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "enabled",
                "stsCIDRs",
                "podIdentityAgentEnabled"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "stsCIDRs": {
                  "type": "array",
                  "maxItems": 8,
                  "uniqueItems": true,
                  "items": {
                    "allOf": [
                      {
                        "$ref": "#/$defs/ipCidr"
                      },
                      {
                        "pattern": "/(32|128)$"
                      }
                    ],
                    "not": {
                      "pattern": "^(0\\.|127\\.|169\\.254\\.|::1/|::/|fd00:ec2:)"
                    }
                  }
                },
                "podIdentityAgentEnabled": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        "networkFamily": {
          "type": "string",
          "enum": [
            "IPv4",
            "IPv6"
          ],
          "default": "IPv4"
        },
        "awsRegion": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^$|^[a-z]{2}(-[a-z]+)+-[0-9]+$"
        }
      }
    },
    "images": {
      "type": "object",
      "required": [
        "ballistaScheduler",
        "ballistaExecutor"
      ],
      "additionalProperties": false,
      "properties": {
        "ballistaScheduler": {
          "$ref": "#/$defs/image"
        },
        "ballistaExecutor": {
          "$ref": "#/$defs/image"
        }
      }
    }
  },
  "$defs": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "digest",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^@\\s]+$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
    },
    "secretKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "ipCidr": {
      "type": "string",
