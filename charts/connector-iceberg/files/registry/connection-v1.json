{
  "type": "object",
  "properties": {
    "storage": {
      "type": "object",
      "properties": {
        "backend": {
          "type": "string",
          "enum": [
            "s3",
            "gcs"
          ]
        },
        "bucket": {
          "type": "string",
          "minLength": 3,
          "maxLength": 63
        },
        "prefix": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1024
        },
        "expectedPrincipal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "region": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "backend",
        "bucket",
        "prefix",
        "expectedPrincipal"
      ],
      "additionalProperties": false
    },
    "credentialsSecretRef": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[a-z0-9][a-z0-9.-]*[a-z0-9]$|^[a-z0-9]$"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "metadataPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "catalog": {
      "type": "object",
      "required": [
        "endpoint",
        "policyRef",
        "allowedNamespaces",
        "auth"
      ],
      "additionalProperties": false,
      "properties": {
        "endpoint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "policyRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "auth": {
          "type": "string",
          "enum": [
            "anonymous",
            "bearer"
          ]
        },
        "allowedNamespaces": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          }
        }
      }
    }
  },
  "required": [
    "storage",
    "credentialsSecretRef"
  ],
  "additionalProperties": false,
  "oneOf": [
    {
      "required": [
        "metadataPath"
      ]
    },
    {
      "required": [
        "catalog"
      ]
    }
  ]
}
